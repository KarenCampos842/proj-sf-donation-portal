<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <decisions>
        <name>End_Date_Passed</name>
        <label>¿Ya terminó su fecha de cierre?</label>
        <locationX>176</locationX>
        <locationY>287</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_Expired</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.End_Date__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.End_Date__c</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>$Flow.CurrentDate</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Close_Campaign</targetReference>
            </connector>
            <label>Sí</label>
        </rules>
    </decisions>
    <description>GES-11. Corre a diario después de la medianoche (hora de la org, America/Mexico_City, igual que Mérida). Pasa a Cerrada, con causa "Por fecha", cada campaña Activa o Pausada cuya fecha de cierre ya terminó. No toca la campaña general ni las campañas sin fecha de cierre. Las donaciones de pagos que ya estaban en curso se siguen registrando (DON-24).</description>
    <environments>Default</environments>
    <interviewLabel>Campaign - Close Expired {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Campaña - Cierre automático por fecha</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Close_Campaign</name>
        <label>Cerrar campaña</label>
        <locationX>44</locationX>
        <locationY>395</locationY>
        <inputAssignments>
            <field>Status__c</field>
            <value>
                <stringValue>Closed</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Close_Reason__c</field>
            <value>
                <stringValue>By_Date</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <runInMode>SystemModeWithoutSharing</runInMode>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>End_Date_Passed</targetReference>
        </connector>
        <filterLogic>(1 OR 2) AND 3</filterLogic>
        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Active</stringValue>
            </value>
        </filters>
        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Paused</stringValue>
            </value>
        </filters>
        <filters>
            <field>Is_General__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Fundraising_Campaign__c</object>
        <schedule>
            <frequency>Daily</frequency>
            <startDate>2026-11-18</startDate>
            <startTime>00:05:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Active</status>
</Flow>
