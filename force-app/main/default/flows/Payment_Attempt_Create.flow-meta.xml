    <description>PAY-07. Revalida en el servidor la campaña y los datos del formulario y crea el intento de pago. Corre en modo sistema: el invitado no tiene permisos sobre Payment_Attempt__c. Devuelve attemptId o un errorMessage apto para mostrarse al donante.</description>
    <formulas>
        <name>fxFriendlyError</name>
        <dataType>String</dataType>
        <expression>IF(CONTAINS({!$Flow.FaultMessage}, &quot;El monto mínimo&quot;), &quot;El monto mínimo es de $50 MXN.&quot;,
IF(CONTAINS({!$Flow.FaultMessage}, &quot;Escribe el nombre&quot;), &quot;Escribe el nombre con el que quieres aparecer.&quot;,
IF(CONTAINS({!$Flow.FaultMessage}, &quot;faltan datos fiscales&quot;), &quot;Para pedir factura faltan datos fiscales.&quot;,
IF(CONTAINS({!$Flow.FaultMessage}, &quot;El RFC no tiene&quot;), &quot;El RFC no tiene un formato válido.&quot;,
IF(CONTAINS({!$Flow.FaultMessage}, &quot;El código postal&quot;), &quot;El código postal debe tener 5 dígitos.&quot;,
IF(CONTAINS({!$Flow.FaultMessage}, &quot;INVALID_EMAIL_ADDRESS&quot;), &quot;Escribe un correo válido.&quot;,
IF(CONTAINS({!$Flow.FaultMessage}, &quot;REQUIRED_FIELD_MISSING&quot;), &quot;Faltan datos obligatorios de tu donación.&quot;,
&quot;No pudimos registrar tus datos, intenta de nuevo.&quot;)))))))</expression>
    </formulas>
    <formulas>
        <name>fxLegalName</name>
        <dataType>String</dataType>
        <expression>IF({!invoiceRequested}, {!legalName}, &quot;&quot;)</expression>
    </formulas>
    <formulas>
        <name>fxPublicName</name>
        <dataType>String</dataType>
        <expression>IF({!visibility} = &quot;Public&quot;, {!publicName}, &quot;&quot;)</expression>
    </formulas>
    <formulas>
        <name>fxRfc</name>
        <dataType>String</dataType>
        <expression>IF({!invoiceRequested}, UPPER(SUBSTITUTE({!rfc}, &quot; &quot;, &quot;&quot;)), &quot;&quot;)</expression>
    </formulas>
    <formulas>
        <name>fxTaxPostalCode</name>
        <dataType>String</dataType>
        <expression>IF({!invoiceRequested}, {!taxPostalCode}, &quot;&quot;)</expression>
    </formulas>
    <formulas>
        <name>fxTaxRegime</name>
        <dataType>String</dataType>
        <expression>IF({!invoiceRequested}, {!taxRegime}, &quot;&quot;)</expression>
    </formulas>
    <formulas>
        <name>fxTaxRegimeIsValid</name>
        <dataType>Boolean</dataType>
        <expression>OR(NOT({!invoiceRequested}), ISBLANK({!taxRegime}), CONTAINS(&quot;,601,603,605,606,607,608,610,611,612,614,615,616,620,621,622,623,624,625,626,&quot;, &quot;,&quot; &amp; {!taxRegime} &amp; &quot;,&quot;))</expression>
    </formulas>
