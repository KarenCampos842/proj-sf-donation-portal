<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <assignments>
        <name>Normalize_RFC</name>
        <label>Normalizar RFC</label>
        <locationX>176</locationX>
        <locationY>287</locationY>
        <assignmentItems>
            <assignToReference>$Record.RFC__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>NormalizedRFC</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <description>Antes de guardar, convierte el RFC a mayúsculas y le quita los espacios, para que la regla RFC_Format reciba el valor limpio (DON-12).</description>
    <environments>Default</environments>
    <formulas>
        <name>NormalizedRFC</name>
        <dataType>String</dataType>
        <expression>UPPER(SUBSTITUTE({!$Record.RFC__c}, &quot; &quot;, &quot;&quot;))</expression>
    </formulas>
    <interviewLabel>Payment Attempt - Normalize RFC {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Intento de pago - Normalizar RFC</label>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Normalize_RFC</targetReference>
        </connector>
        <filterFormula>NOT(ISBLANK({!$Record.RFC__c}))</filterFormula>
        <object>Payment_Attempt__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
