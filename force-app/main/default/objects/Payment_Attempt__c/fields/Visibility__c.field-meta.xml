<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Visibility__c</fullName>
    <description>Indica si el donante quiere aparecer con nombre (Pública) o sin él (Anónima). Es independiente de la solicitud de factura.</description>
    <inlineHelpText>Elige si tu nombre se mostrará públicamente.</inlineHelpText>
    <label>Visibilidad</label>
    <required>false</required>
    <type>Picklist</type>
    <valueSet>
        <valueSetDefinition>
            <sorted>false</sorted>
            <value>
                <fullName>Anonymous</fullName>
                <default>false</default>
                <label>Anónima</label>
            </value>
            <value>
                <fullName>Public</fullName>
                <default>false</default>
                <label>Pública</label>
            </value>
        </valueSetDefinition>
    </valueSet>
</CustomField>
