#!/usr/bin/env bash
# Blocks commits that contain Stripe-style secrets (M3).
# Enable with: git config core.hooksPath .githooks

PATTERN='(sk|rk)_(test|live)_[A-Za-z0-9]{8,}|whsec_[A-Za-z0-9]{8,}'

# Only inspect added lines of the staged diff.
HITS=$(git diff --cached -U0 --no-color | grep -E '^\+' | grep -vE '^\+\+\+' | grep -E "$PATTERN")

if [ -n "$HITS" ]; then
  echo "COMMIT BLOCKED: possible Stripe secret found in staged changes."
  echo "Remove it, and if it was ever pasted anywhere public, rotate it in Stripe today."
  echo "$HITS" | sed -E 's/((sk|rk)_(test|live)_|whsec_)[A-Za-z0-9]+/\1****REDACTED****/g'
  exit 1
fi
exit 0
